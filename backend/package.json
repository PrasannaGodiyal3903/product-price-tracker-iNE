{
  "name": "product-price-tracker-backend",
  "version": "1.0.0",
  "description": "Backend API and Playwright scraper for Product Price Tracker",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "vitest run",
    "scraper:headed": "ts-node src/headed-runner.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "playwright": "^1.50.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  },
  "vitest": {
    "pool": "forks",
    "poolOptions": {
      "forks": {
        "singleFork": true
      }
    }
  }
}
