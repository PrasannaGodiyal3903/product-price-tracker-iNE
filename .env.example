# Server Port
PORT=5000
NODE_ENV=development

# Frontend & Backend URLs (for CORS and API access)
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5000

# Supabase Credentials
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Scheduler Authentication Secret (Required for POST /api/scraper/run)
CRON_SECRET=super-secret-cron-token-12345

# Scraper Settings
SCRAPER_HEADLESS=true
SCRAPER_MAX_RETRIES=3
SCRAPER_INITIAL_DELAY_MS=1500
SCRAPER_TIMEOUT_MS=15000
